# Østfoldbussen – eksempelkonfigurasjon for selvhosting.
#
# Kopier til .env og tilpass. Hemmeligheter skal ikke committes; bruk
# state/secrets/ eller egne filer utenfor repoet. Filene må være 0600.
# Alle variabler listes her. Hemmelighetsfeltene er bevisst tomme.

# --- App -------------------------------------------------------------------
APP_ENV=development
APP_TIMEZONE=Europe/Oslo
# Lokal Python: 127.0.0.1. I Docker må appen lytte på 0.0.0.0 internt;
# compose overstyrer dette og publiserer bare på vertens loopback.
HOST=127.0.0.1
PORT=8000
DATABASE_PATH=./state/lib/app.db
LOG_LEVEL=INFO
BUILD_SHA=dev
# Ekstern URL bak Caddy; brukes bl.a. til webhook- og statuslenker.
PUBLIC_BASE_URL=http://127.0.0.1:8080
# Sett true bare når appen er bak en betrodd reverse proxy (Caddy) som
# setter X-Forwarded-For. Direkte eksponering skal ha false.
TRUST_PROXY=false
# Kommaseparerte peer-CIDR som får sende X-Forwarded-For når TRUST_PROXY=true.
# Tom liste = ingen peers stoles på (fail-closed).
TRUSTED_PROXY_IPS=
COOKIE_SECURE=false

# --- HTTP-vern -------------------------------------------------------------
MAX_BODY_BYTES=8192
MAX_MESSAGE_CHARS=1600
REQUEST_TIMEOUT_S=20
# /api/simulate er en testflate. Krev admin-innlogging for offentlig eksponering.
# Produksjon: true. Lokal testflate kan bevisst settes til false.
SIMULATE_REQUIRE_AUTH=true
SIMULATE_RATE_LIMIT_PER_HOUR=60

# --- Entur (åpne tjenester, ingen nøkkel) ----------------------------------
# Sett din egen unike identitet før ekte Entur-kall. Ikke bruk den offisielle
# Østfoldbussen-identiteten i en selvhostet installasjon.
ENTUR_CLIENT_NAME=ostfoldbussen-selfhosted
ENTUR_GEOCODER_URL=https://api.entur.io/geocoder/v3
ENTUR_JOURNEY_PLANNER_URL=https://api.entur.io/journey-planner/v3/graphql
ENTUR_TIMEOUT_S=15
ENTUR_MAX_RETRIES=3

# --- Terskler (IKKE vedtatte produktvalg; trygge defaults) -----------------
# transferSlack er API-ets harde minimumsovergang (default 120 s).
TRANSFER_SLACK_S=120
# Ettervalideringsminimum; tom => samme som TRANSFER_SLACK_S.
MIN_TRANSFER_S=
WARN_TRANSFER_BELOW_S=300
# Ganggrenser: tomme => ingen hard grense (kun advarsel ved WARN-grensen).
MAX_WALK_M=
MAX_WALK_LEG_M=
MAX_WALK_TIME_S=
NUM_TRIP_PATTERNS=10
SEARCH_WINDOW_MINUTES=
# flag_only = vis men flagg cross-border; require_in_scope = avvis.
SCOPE_POLICY=flag_only

# --- SMS: inMobile-adapter (AV som standard) -------------------------------
INMOBILE_WEBHOOK_ENABLED=false
INMOBILE_WEBHOOK_KEY_ID=
INMOBILE_WEBHOOK_PUBLIC_KEY=
INMOBILE_API_KEY=
INMOBILE_FROM=
INMOBILE_OUTBOUND_ENABLED=false
# Fail-closed: 0 betyr ingen utsending. Må settes >0 når utgående SMS aktiveres.
DAILY_SMS_LIMIT=0
RATE_LIMIT_PER_HOUR=5
# Tomme => vises som UKJENT i admin (ingen oppdiktede priser).
SMS_UNIT_COST_NOK=
LLM_UNIT_COST_NOK=

# --- LLM (AV; ingen nøkkel) -------------------------------------------------
LLM_ENABLED=false
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_S=10
LLM_MAX_INPUT_CHARS=500
# Valgfri egen HMAC-nøkkel for meldingshash; minst 32 tegn.
# Tom = ingen meldingshash lagres (ingen usaltet SHA-256-fallback).
MESSAGE_HASH_KEY=

# --- Admin (hemmeligheter i state/secrets eller *_FILE) ---------------------
ADMIN_USER=admin
# Generer med: python3 -m app auth-hash > state/secrets/admin_password_hash
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
SESSION_TTL_S=28800
SESSION_COOKIE=ob_session
CSRF_COOKIE=ob_csrf

# --- Kontakt / SMTP ---------------------------------------------------------
# Skjemaet aktiveres når SMTP_HOST er satt. Passord i secrets (SMTP_PASSWORD).
PUBLIC_CONTACT_EMAIL=
SMTP_HOST=
# 587 = STARTTLS; 465 = implicit TLS (SMTP_STARTTLS ignoreres for 465).
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
CONTACT_TO=
# Produksjon krever TLS: STARTTLS på andre porter, implicit TLS på 465.
SMTP_STARTTLS=true
CONTACT_RATE_LIMIT_PER_HOUR=5

# --- Personvern -------------------------------------------------------------
# HMAC-salt for pseudonymisering av avsender (ALDRI i repo/logg).
PSEUDONYM_SALT=
CONVERSATION_TTL_MINUTES=30

# --- Helse ------------------------------------------------------------------
HEALTH_ENTUR_CHECK=true
HEALTH_ENTUR_CACHE_S=60
HEALTH_ENTUR_TIMEOUT_S=3

# --- Valgfri LLM-utvidelse og Bineric (alle av som standard) ----------------
# LLM_ENABLED, LLM_BASE_URL, LLM_MODEL, LLM_API_KEY og LLM_TIMEOUT_S er
# dokumentert over. Disse styrer valgfri output/effort:
LLM_MAX_OUTPUT_TOKENS=400
LLM_REASONING_EFFORT=none
BINERIC_ENABLED=false
BINERIC_BASE_URL=
BINERIC_MODEL=
BINERIC_API_KEY=
BINERIC_TIMEOUT_S=20
BINERIC_MAX_OUTPUT_TOKENS=192
BINERIC_MAX_CONCURRENCY=2
BINERIC_REQUESTS_PER_MINUTE=60
BINERIC_MAX_RETRIES=2
BINERIC_DAILY_BUDGET_USD=5.0

# --- Offentlig side / SMS / Matomo (valgfritt) -----------------------------
PUBLIC_SMS_ENABLED=false
PUBLIC_SMS_NUMBER=
PUBLIC_MATOMO_ENABLED=false
PUBLIC_MATOMO_URL=
PUBLIC_MATOMO_SITE_ID=1
STATUS_NOTICE=

# --- Inbound policy og retensjon -------------------------------------------
INBOUND_DAILY_LIMIT=200
INBOUND_RATE_LIMIT_PER_HOUR=30
RETENTION_REQUESTS_DAYS=30
RETENTION_DELIVERIES_DAYS=30
RETENTION_REVIEWS_DAYS=90

# --- Katalog for filbaserte hemmeligheter ----------------------------------
# Brukes av lokal kjøring og Docker (Compose overstyrer til /run/secrets).
SECRETS_DIR=./state/secrets
